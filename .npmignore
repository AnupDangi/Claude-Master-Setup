# Keep the published tarball lean.
# package.json "files" is the real allowlist (npm does not reliably
# subtract .npmignore entries from an included directory). This file
# only excludes local/runtime junk that might otherwise sneak in.

.claude/state/
.claude/settings.local.json
.cursor/
test-harness/
**/node_modules/
**/.DS_Store
*.tgz
.env
.env.*
.github/
