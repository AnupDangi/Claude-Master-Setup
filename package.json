{
  "name": "claude-master-setup",
  "version": "0.6.1",
  "description": "Adaptive Ralph-style loops for Claude Code with project-first bootstrap, JSON state, validation, and compute-aware agents.",
  "bin": {
    "claude-master-setup": "bin/cli.js"
  },
  "scripts": {
    "test": "MASTER_SELF_CHECK_SKIP_VALIDATE=1 bash scripts/self-check.sh && node --check bin/cli.js && bash scripts/test-ship-install.sh",
    "check": "bash scripts/self-check.sh",
    "prepack": "bash scripts/self-check.sh && node --check bin/cli.js"
  },
  "files": [
    ".claude-plugin",
    ".claude/agents",
    ".claude/commands",
    ".claude/hooks",
    ".claude/settings.json",
    "bin/cli.js",
    "templates/CLAUDE.md.starter",
    "templates/project.json",
    "templates/master-docs/ROADMAP.md",
    "MASTER-PROMPT.md",
    "LICENSE",
    "README.md",
    "docs/SETUP.md",
    "docs/LOOP.md",
    "docs/SECURITY.md",
    "scripts/detect-stack.sh",
    "scripts/list-local-skills.sh",
    "scripts/select-skills.sh",
    "scripts/validate.sh",
    "scripts/worktree-fanout.sh",
    "scripts/setup-loop.sh",
    "scripts/cancel-loop.sh",
    "scripts/classify-task.py",
    "scripts/write-handoff.py"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "Anup Dangi",
  "keywords": [
    "claude-code",
    "claude",
    "ai-agent",
    "autonomous-engineering",
    "harness",
    "subagents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnupDangi/Claude-Master-Setup.git"
  },
  "homepage": "https://github.com/AnupDangi/Claude-Master-Setup#readme",
  "bugs": {
    "url": "https://github.com/AnupDangi/Claude-Master-Setup/issues"
  }
}
