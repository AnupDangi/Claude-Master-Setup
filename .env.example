# .env.example — harness environment variables
# Copy to .env and fill in values. Never commit .env.
#
# These are optional; the harness works without them.
# Set only what you actually need.

# Budget and iteration limits (override defaults in .claude/settings.json)
# HARNESS_MAX_VALIDATE_RETRIES=3
# HARNESS_MAX_ITERATIONS_PER_RUN=1
# HARNESS_MAX_COMMITS_PER_DAY=20
# HARNESS_MAX_EVENTS_PER_DAY=200

# Custom Claude config dir (default: ~/.claude)
# CLAUDE_CONFIG_DIR=~/.claude

# Project-specific env vars go below (added by /bootstrap per your stack):
