{
  "name": "claude-master-setup",
  "version": "0.4.1",
  "description": "AI OS harness for Claude Code — build-effort dial, engineered loop (plan/build/validate/review/security/commit), local skills, worktree fan-out, event log, leases, and hard quality gates.",
  "bin": {
    "claude-master-setup": "bin/cli.js"
  },
  "scripts": {
    "test": "HARNESS_SELF_CHECK_SKIP_VALIDATE=1 bash scripts/self-check.sh && node --check bin/cli.js",
