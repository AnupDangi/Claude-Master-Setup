# Copy to .env and fill in. .env is gitignored — never commit real secrets.
# The mcp-scout appends the vars a server needs here when you run /mcp-add.

# --- Common MCP server credentials (uncomment what you use) ---
# GITHUB_PAT=              # fine-grained PAT, repo:read unless push is needed
# DATABASE_URL=            # e.g. postgres://readonly_user:pass@host:5432/db
# SQLITE_DB_PATH=          # absolute path to a .db file
# STRIPE_API_KEY=          # RESTRICTED/read-only key
# SUPABASE_ACCESS_TOKEN=
# WORKSPACE_DIR=.          # dir the filesystem MCP server may access

# --- Harness flags ---
# HARNESS_ALLOW_NO_STACK=0 # set 1 for a docs-only repo so the gate isn't RED
