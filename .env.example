# Copy to .env and fill in. .env is gitignored — never commit real secrets.
# The mcp-scout appends the vars a server needs here when you run /mcp-add.

# --- Common MCP server credentials (uncomment what you use) ---
# GITHUB_PAT=              # fine-grained PAT, repo:read unless push is needed
# DATABASE_URL=            # e.g. postgres://readonly_user:pass@host:5432/db
# SQLITE_DB_PATH=          # absolute path to a .db file
# STRIPE_API_KEY=          # RESTRICTED/read-only key
# SUPABASE_ACCESS_TOKEN=
# WORKSPACE_DIR=.          # dir the filesystem MCP server may access

# --- Harness flags ---
# HARNESS_ALLOW_NO_STACK=0 # set 1 for a docs-only repo so the gate isn't RED
# HARNESS_MAX_VALIDATE_RETRIES=3
# HARNESS_BUILD_EFFORT_TIER=        # optional override: fast|standard|rigorous
# HARNESS_MAX_ITERATIONS_PER_RUN=1  # /loop stops after N COMMITs (raise deliberately)
# HARNESS_MAX_COMMITS_PER_DAY=20
# HARNESS_MAX_EVENTS_PER_DAY=200
# HARNESS_BUDGET_STOP=1
# HARNESS_LEASE_TTL_SECONDS=7200
# HARNESS_ALLOW_PROTECTED_EDITS=0  # set 1 only to intentionally edit .env/lockfiles/CI
# HARNESS_MAX_PARALLEL_ORCH=3
# HARNESS_MAX_PARALLEL_PLANNER=3
# HARNESS_MAX_PARALLEL_IMPLEMENTER=5
# HARNESS_MAX_PARALLEL_EVALUATOR=3
# HARNESS_MAX_SKILLS_PER_TASK=3
# HARNESS_SKILLS_SOURCES=project,user,plugin  # default: auto-discover all local sources
# HARNESS_SKILLS_MAX=80
