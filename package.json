{
  "name": "agent-master-setup",
  "version": "1.1.0",
  "description": "Portable project state, validation evidence, and reliable handoffs across Claude Code, Codex, Cursor, and other coding agents.",
  "bin": {
    "agent-master": "bin/cli.js",
    "agent-master-setup": "bin/cli.js",
    "claude-master-setup": "bin/compat-cli.js"
  },
  "scripts": {
    "test": "MASTER_SELF_CHECK_SKIP_VALIDATE=1 bash scripts/self-check.sh && bash scripts/check-skills-allowlist.sh && node --check bin/cli.js && node --check lib/agent-master.js && bash scripts/test-universal-cli.sh && bash scripts/test-ship-install.sh && bash scripts/test-golden-loop.sh",
    "check": "bash scripts/self-check.sh",
    "docs:diagrams": "bash scripts/render-diagrams.sh",
    "prepack": "bash scripts/self-check.sh && node --check bin/cli.js && node --check lib/agent-master.js",
    "prepublishOnly": "npm run docs:diagrams"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.16.0"
  },
  "files": [
    ".claude-plugin",
    ".claude/commands",
    ".claude/hooks",
    ".claude/settings.json",
    ".claude/statusline.sh",
    "bin/cli.js",
    "bin/compat-cli.js",
    "lib",
    "adapters",
    "templates/CLAUDE.md.starter",
    "templates/AGENTS.md.starter",
    "templates/CURSOR.mdc.starter",
    "templates/MASTER_README.md",
    "templates/project.json",
    "templates/master-docs/ROADMAP.md",
    "LICENSE",
    "README.md",
    "docs/SETUP.md",
    "docs/LOOP.md",
    "docs/SECURITY.md",
    "scripts/detect-stack.sh",
    "scripts/list-local-skills.sh",
    "scripts/select-skills.sh",
    "scripts/sync-project-docs.sh",
    "templates/master-docs/DESIGN.md",
    "templates/master-docs/DECISIONS.md",
    "templates/master-docs/API.md",
    "templates/master-docs/DATABASE.md",
    "templates/master-docs/DEPLOYMENT.md",
    "templates/master-docs/SECURITY.md",
    "templates/master-docs/TESTING.md",
    "scripts/install-default-skills.sh",
    "templates/skills-allowlist.json",
    "scripts/install-skill.sh",
    "scripts/ensure-skills.sh",
    "scripts/check-skills-allowlist.sh",
    "scripts/test-golden-loop.sh",
    "scripts/test-universal-cli.sh",
    "templates/skills-list-snapshot.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "Anup Dangi",
  "keywords": [
    "agent-master",
    "codex",
    "cursor",
    "claude-code",
    "ai-agent",
    "cross-agent",
    "handoff",
    "validation",
    "harness",
    "agent-memory"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnupDangi/Claude-Master-Setup.git"
  },
  "homepage": "https://github.com/AnupDangi/Claude-Master-Setup#readme",
  "bugs": {
    "url": "https://github.com/AnupDangi/Claude-Master-Setup/issues"
  }
}
