{
  "$schema": "https://json.schemastore.org/claude-code-plugin.json",
  "name": "master",
  "displayName": "Claude Master Setup",
  "description": "Autonomous engineering harness: plan, build, validate, review, and commit in a repeatable loop with 11 specialist subagents and hard quality gates.",
  "version": "0.4.0",
  "author": { "name": "Anup Dangi" },
  "homepage": "https://github.com/AnupDangi/Claude-Master-Setup",
  "repository": "https://github.com/AnupDangi/Claude-Master-Setup",
  "license": "MIT",
  "keywords": ["claude-code", "harness", "autonomous-engineering", "subagents", "ai-os"],
  "commands": ["./.claude/commands/"],
  "agents": [
    "./.claude/agents/architect.md",
    "./.claude/agents/docs-writer.md",
    "./.claude/agents/evaluator.md",
    "./.claude/agents/implementer-opus.md",
    "./.claude/agents/implementer.md",
    "./.claude/agents/mcp-scout.md",
    "./.claude/agents/orchestrator.md",
    "./.claude/agents/planner.md",
    "./.claude/agents/reviewer.md",
    "./.claude/agents/security.md",
    "./.claude/agents/validator.md"
  ],
  "skills": ["./.claude/skills/"],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/session-start.sh\""
          }
        ],
        "description": "Print loop state and remind to read CLAUDE.md on new session",
        "id": "harness:session-start"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/pre-bash-guard.sh\""
          }
        ],
        "description": "Block dangerous shell commands (rm -rf /, piped installers, secret reads)",
        "id": "harness:pre-bash-guard"
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/protect-paths.sh\""
          }
        ],
        "description": "BLOCK .env*/lockfiles/CI/control-plane (.claude hooks/settings/agents/commands, validate.sh) unless HARNESS_ALLOW_PROTECTED_EDITS=1",
        "id": "harness:protect-paths"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/post-edit-track.sh\"",
            "async": true,
            "timeout": 15
          }
        ],
        "description": "Record edited source files so the loop knows validation is pending",
        "id": "harness:post-edit-track"
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/stop-validate-reminder.sh\"",
            "async": true,
            "timeout": 10
          }
        ],
        "description": "Remind to run the validation gate if source changed but validate did not run",
        "id": "harness:stop-validate-reminder"
      }
    ]
  }
}
